{% comment %} Six configurable hotspot products using the supplied Figma imagery as a fallback. {% endcomment %}
<section id="candidate-grid" class="candidate-grid" data-candidate-grid data-companion-handle="{{ section.settings.companion_product.handle }}">
  <div class="candidate-grid__inner"><h2>{{ section.settings.heading | escape }}</h2><div class="candidate-grid__cards">
    {% for block in section.blocks limit: 6 %}{% assign product = block.settings.product %}{% capture fallback %}candidate-grid-{{ forloop.index }}.png{% endcapture %}
      <article class="candidate-card" {{ block.shopify_attributes }} style="--hotspot-x: {{ block.settings.hotspot_horizontal }}%; --hotspot-y: {{ block.settings.hotspot_vertical }}%;"><button type="button" data-product-card {% if product == blank %}disabled{% endif %} aria-label="View {{ product.title | default: 'product' | escape }}">{% if block.settings.image != blank %}{{ block.settings.image | image_url: width: 900 | image_tag: loading: 'lazy', widths: '320, 480, 640, 900' }}{% elsif product.featured_image != blank %}{{ product.featured_image | image_url: width: 900 | image_tag: loading: 'lazy', widths: '320, 480, 640, 900', alt: product.title }}{% else %}<img src="{{ fallback | asset_url }}" width="433" height="444" loading="lazy" alt="">{% endif %}<span class="candidate-card__hotspot" aria-hidden="true">+</span></button>{% if product != blank %}<script type="application/json" data-product-json>{{ product | json }}</script>{% endif %}</article>
    {% endfor %}
  </div></div>
  <dialog class="candidate-modal" data-product-modal aria-label="Product details"><button class="candidate-modal__close" type="button" data-close-modal aria-label="Close product details">×</button><div data-modal-content></div></dialog>
</section>
{% stylesheet %}
  .candidate-grid { padding: 0 26px 80px; background: #fff; color: #000; font-family: Jost, Arial, sans-serif; }.candidate-grid__inner { max-width: 1388px; margin: 0 auto; }.candidate-grid h2 { margin: 0 0 30px; font-family: Lustria, Georgia, serif; font-size: 36px; font-weight: 400; line-height: 1.2; }.candidate-grid__cards { display: grid; grid-template-columns: repeat(3, 1fr); gap: 10px 20px; }.candidate-card button { position: relative; display: block; width: 100%; padding: 0; border: 0; background: none; cursor: pointer; }.candidate-card button:disabled { cursor: default; }.candidate-card img { display: block; width: 100%; aspect-ratio: 433 / 444; object-fit: cover; }.candidate-card__hotspot { position: absolute; left: var(--hotspot-x); top: var(--hotspot-y); display: grid; width: 22px; height: 22px; place-items: center; border-radius: 50%; background: #fff; color: #000; font-size: 18px; font-weight: 500; line-height: 1; transform: translate(-50%, -50%); box-shadow: 0 1px 3px rgb(0 0 0 / 20%); transition: transform .2s ease; }.candidate-card button:hover .candidate-card__hotspot { transform: translate(-50%, -50%) scale(1.2) rotate(90deg); }
  .candidate-modal { width: min(820px, calc(100vw - 32px)); max-height: min(670px, calc(100dvh - 32px)); padding: 0; overflow: visible; border: 0; background: #fff; color: #000; box-shadow: 0 18px 80px rgb(0 0 0 / 30%); }.candidate-modal::backdrop { background: rgb(0 0 0 / 54%); }.candidate-modal__close { position: absolute; z-index: 2; top: 12px; right: 12px; width: 38px; height: 38px; border: 0; border-radius: 50%; background: #fff; font-size: 29px; cursor: pointer; }.candidate-modal [data-modal-content] { display: grid; grid-template-columns: 1.05fr .95fr; }.candidate-modal__media { min-height: 500px; background: #f5f5f5; }.candidate-modal__media img { display: block; width: 100%; height: 100%; object-fit: cover; }.candidate-modal__info { padding: 45px; }.candidate-modal__title { margin: 0; font-size: 42px; font-weight: 500; letter-spacing: -.04em; line-height: 1; }.candidate-modal__price { margin: 16px 0 24px; font-weight: 700; }.candidate-modal__description { margin-bottom: 25px; font-size: 14px; line-height: 1.55; }.candidate-modal fieldset { margin: 0 0 18px; padding: 0; border: 0; }.candidate-modal legend { margin-bottom: 9px; font-size: 11px; font-weight: 700; letter-spacing: .12em; text-transform: uppercase; }.candidate-modal__values { display: flex; flex-wrap: wrap; gap: 8px; }.candidate-modal__values label { display: inline-flex; cursor: pointer; }.candidate-modal__values input { position: absolute; opacity: 0; }.candidate-modal__values span { min-width: 41px; padding: 10px 12px; border: 1px solid #aaa; font-size: 12px; text-align: center; }.candidate-modal__values input:checked + span { background: #000; color: #fff; }.candidate-modal__add { width: 100%; margin-top: 10px; padding: 17px; border: 0; background: #000; color: #fff; font-size: 12px; letter-spacing: .1em; text-transform: uppercase; cursor: pointer; }.candidate-modal__add:disabled { opacity: .5; cursor: not-allowed; }.candidate-modal__status { min-height: 20px; margin: 12px 0 0; font-size: 13px; }
  @media screen and (max-width: 749px) { .candidate-grid { padding: 35px 16px 40px; }.candidate-grid h2 { margin-bottom: 16px; font-size: 24px; text-align: center; }.candidate-grid__cards { grid-template-columns: repeat(2, 1fr); gap: 4px; }.candidate-card img { aspect-ratio: 169 / 186.42; }.candidate-card__hotspot { width: 16px; height: 16px; font-size: 14px; }.candidate-modal { width: calc(100vw - 20px); max-height: calc(100dvh - 20px); overflow: auto; }.candidate-modal [data-modal-content] { grid-template-columns: 1fr; }.candidate-modal__media { min-height: 290px; max-height: 42vh; }.candidate-modal__info { padding: 28px 22px; }.candidate-modal__title { font-size: 32px; } }
{% endstylesheet %}
<script>
  (() => { const root = document.currentScript.closest('[data-candidate-grid]'); if (!root) return; const modal = root.querySelector('[data-product-modal]'); const content = root.querySelector('[data-modal-content]'); const money = cents => new Intl.NumberFormat(document.documentElement.lang || 'en', { style: 'currency', currency: '{{ cart.currency.iso_code | default: shop.currency }}' }).format(cents / 100); const escapeHtml = value => String(value).replace(/[&<>'"]/g, char => ({ '&':'&amp;', '<':'&lt;', '>':'&gt;', "'":'&#39;', '"':'&quot;' }[char]));
    const render = product => { const options = product.options_with_values || product.options.map((name, i) => ({ name, values: [...new Set(product.variants.map(v => v.options[i]))] })); content.innerHTML = `<div class="candidate-modal__media"><img src="${product.featured_image || ''}" alt="${escapeHtml(product.title)}"></div><div class="candidate-modal__info"><h3 class="candidate-modal__title">${escapeHtml(product.title)}</h3><p class="candidate-modal__price" data-price>${money(product.price)}</p><div class="candidate-modal__description">${product.description || ''}</div><form data-product-form>${options.map((option, i) => `<fieldset><legend>${escapeHtml(option.name)}</legend><div class="candidate-modal__values">${option.values.map((value, n) => `<label><input type="radio" name="option-${i}" value="${escapeHtml(value)}" ${n === 0 ? 'checked' : ''}><span>${escapeHtml(value)}</span></label>`).join('')}</div></fieldset>`).join('')}<button class="candidate-modal__add" type="submit">Add to cart</button><p class="candidate-modal__status" role="status" aria-live="polite"></p></form></div>`; const form = content.querySelector('[data-product-form]'); const submit = form.querySelector('button'); const update = () => { const values = options.map((_, i) => form.querySelector(`[name="option-${i}"]:checked`)?.value); const variant = product.variants.find(v => v.options.every((value, i) => value === values[i])); submit.disabled = !variant || !variant.available; submit.dataset.variantId = variant?.id || ''; submit.textContent = variant?.available ? 'Add to cart' : 'Sold out'; if (variant) content.querySelector('[data-price]').textContent = money(variant.price); }; form.addEventListener('change', update); update(); form.addEventListener('submit', async e => { e.preventDefault(); const variant = product.variants.find(v => String(v.id) === submit.dataset.variantId); if (!variant) return; submit.disabled = true; const status = form.querySelector('[role="status"]'); status.textContent = 'Adding to cart…'; const items = [{ id: variant.id, quantity: 1 }]; const addCompanion = variant.options.some(v => String(v).toLowerCase() === 'black') && variant.options.some(v => String(v).toLowerCase() === 'medium'); if (addCompanion && root.dataset.companionHandle && product.handle !== root.dataset.companionHandle) { try { const p = await fetch(`/products/${root.dataset.companionHandle}.js`).then(r => r.ok ? r.json() : null); const v = p?.variants?.find(i => i.available); if (v) items.push({ id: v.id, quantity: 1 }); } catch (_) {} } try { const response = await fetch('/cart/add.js', { method: 'POST', headers: { 'Content-Type': 'application/json', Accept: 'application/json' }, body: JSON.stringify({ items }) }); if (!response.ok) throw new Error(); status.textContent = items.length > 1 ? 'Both items were added to your cart.' : 'Added to your cart.'; document.dispatchEvent(new CustomEvent('cart:refresh')); } catch (_) { status.textContent = 'Unable to add this item. Please try again.'; submit.disabled = false; } }); };
    root.querySelectorAll('[data-product-card]').forEach(button => button.addEventListener('click', () => { const json = button.closest('.candidate-card').querySelector('[data-product-json]'); if (!json) return; render(JSON.parse(json.textContent)); modal.showModal(); })); root.querySelector('[data-close-modal]').addEventListener('click', () => modal.close()); modal.addEventListener('click', e => { if (e.target === modal) modal.close(); }); })();
</script>
{% schema %}
{ "name": "Candidate product grid", "max_blocks": 6, "settings": [{ "type": "text", "id": "heading", "label": "Heading", "default": "Tisso vison in the wild" }, { "type": "product", "id": "companion_product", "label": "Soft Winter Jacket companion product", "info": "Added when Black and Medium are selected." }], "blocks": [{ "type": "product", "name": "Product hotspot", "settings": [{ "type": "product", "id": "product", "label": "Product" }, { "type": "image_picker", "id": "image", "label": "Card image (optional)" }, { "type": "range", "id": "hotspot_horizontal", "label": "Hotspot horizontal position", "min": 0, "max": 100, "step": 1, "unit": "%", "default": 50 }, { "type": "range", "id": "hotspot_vertical", "label": "Hotspot vertical position", "min": 0, "max": 100, "step": 1, "unit": "%", "default": 50 }] }], "presets": [{ "name": "Candidate product grid", "blocks": [{ "type": "product", "settings": { "hotspot_horizontal": 60, "hotspot_vertical": 54 } }, { "type": "product", "settings": { "hotspot_horizontal": 82, "hotspot_vertical": 50 } }, { "type": "product", "settings": { "hotspot_horizontal": 60, "hotspot_vertical": 19 } }, { "type": "product", "settings": { "hotspot_horizontal": 70, "hotspot_vertical": 16 } }, { "type": "product", "settings": { "hotspot_horizontal": 49, "hotspot_vertical": 23 } }, { "type": "product", "settings": { "hotspot_horizontal": 74, "hotspot_vertical": 37 } }] }] }
{% endschema %}
