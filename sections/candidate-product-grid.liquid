{% comment %}
  Candidate Product Grid
  Six merchant-selectable products with a single reusable dialog. Product and
  variant data comes directly from Shopify and cart requests use the Ajax API.
{% endcomment %}
<section id="candidate-grid" class="candidate-grid candidate-grid--{{ section.id }}" data-candidate-grid data-companion-handle="{{ section.settings.companion_product.handle }}">
  <div class="candidate-grid__header page-width">
    {% if section.settings.eyebrow != blank %}<p>{{ section.settings.eyebrow | escape }}</p>{% endif %}
    <h2>{{ section.settings.heading | escape }}</h2>
  </div>
  <div class="candidate-grid__cards page-width">
    {% for block in section.blocks limit: 6 %}
      {% assign product = block.settings.product %}
      <article class="candidate-card" {{ block.shopify_attributes }}>
        <button class="candidate-card__open" type="button" data-product-card {% if product == blank %}disabled{% endif %} aria-label="View {% if product != blank %}{{ product.title | escape }}{% else %}product{% endif %}">
          <div class="candidate-card__media">
            {% if product.featured_image != blank %}
              {{ product.featured_image | image_url: width: 900 | image_tag: loading: 'lazy', widths: '320, 480, 640, 900', alt: product.featured_image.alt | default: product.title }}
            {% else %}
              {{ 'product-apparel-1' | placeholder_svg_tag: 'candidate-card__placeholder' }}
            {% endif %}
            <span class="candidate-card__hotspot" aria-hidden="true">+</span>
          </div>
          <div class="candidate-card__meta"><span>{{ product.title | default: 'Select a product' | escape }}</span><span>{{ product.price | money }}</span></div>
        </button>
        {% if product != blank %}
          <script type="application/json" data-product-json>{{ product | json }}</script>
        {% endif %}
      </article>
    {% endfor %}
  </div>

  <dialog class="candidate-modal" data-product-modal aria-label="Product details">
    <button class="candidate-modal__close" type="button" data-close-modal aria-label="Close product details">×</button>
    <div class="candidate-modal__content" data-modal-content></div>
  </dialog>
</section>

{% stylesheet %}
  .candidate-grid { padding-block: clamp(56px, 8vw, 112px); background: #f8f7f5; color: #171717; }
  .candidate-grid__header { display: flex; justify-content: space-between; align-items: end; gap: 20px; margin-bottom: 32px; }.candidate-grid__header p { margin: 0; font-size: 11px; font-weight: 700; letter-spacing: .14em; text-transform: uppercase; }.candidate-grid__header h2 { max-width: 680px; margin: 0; font-size: clamp(34px, 4vw, 62px); line-height: .98; letter-spacing: -.05em; }
  .candidate-grid__cards { display: grid; grid-template-columns: repeat(3, 1fr); gap: 18px; }.candidate-card__open { width: 100%; padding: 0; color: inherit; background: none; border: 0; text-align: left; cursor: pointer; }.candidate-card__open:disabled { cursor: default; }.candidate-card__media { position: relative; aspect-ratio: .82; overflow: hidden; background: #e9e6e1; }.candidate-card__media img, .candidate-card__placeholder { width: 100%; height: 100%; object-fit: cover; transition: transform .5s ease; }.candidate-card__open:hover img { transform: scale(1.045); }.candidate-card__hotspot { position: absolute; right: 16px; bottom: 16px; display: grid; width: 42px; height: 42px; place-items: center; border-radius: 50%; background: #fff; color: #171717; font-size: 27px; line-height: 1; box-shadow: 0 3px 16px rgb(0 0 0 / 15%); transition: transform .25s ease; }.candidate-card__open:hover .candidate-card__hotspot { transform: rotate(90deg); }.candidate-card__meta { display: flex; justify-content: space-between; gap: 12px; padding-top: 13px; font-size: 14px; }.candidate-card__meta span:last-child { white-space: nowrap; }
  .candidate-modal { width: min(820px, calc(100vw - 32px)); max-height: min(670px, calc(100dvh - 32px)); padding: 0; overflow: visible; border: 0; background: #fff; color: #161616; box-shadow: 0 18px 80px rgb(0 0 0 / 30%); }.candidate-modal::backdrop { background: rgb(14 14 14 / 54%); backdrop-filter: blur(3px); }.candidate-modal__close { position: absolute; z-index: 2; top: 12px; right: 12px; display: grid; width: 38px; height: 38px; place-items: center; border: 0; border-radius: 50%; background: #fff; color: #171717; font-size: 29px; cursor: pointer; }.candidate-modal__content { display: grid; grid-template-columns: 1.05fr .95fr; }.candidate-modal__media { min-height: 500px; background: #ece9e5; }.candidate-modal__media img { display: block; width: 100%; height: 100%; object-fit: cover; }.candidate-modal__info { padding: clamp(28px, 5vw, 54px); }.candidate-modal__title { margin: 0; font-size: clamp(28px, 4vw, 46px); line-height: .98; letter-spacing: -.05em; }.candidate-modal__price { margin: 17px 0 24px; font-size: 15px; font-weight: 700; }.candidate-modal__description { margin-bottom: 25px; font-size: 14px; line-height: 1.55; }.candidate-modal fieldset { margin: 0 0 18px; padding: 0; border: 0; }.candidate-modal legend { margin-bottom: 9px; font-size: 11px; font-weight: 700; letter-spacing: .12em; text-transform: uppercase; }.candidate-modal__values { display: flex; flex-wrap: wrap; gap: 8px; }.candidate-modal__values label { display: inline-flex; cursor: pointer; }.candidate-modal__values input { position: absolute; opacity: 0; pointer-events: none; }.candidate-modal__values span { min-width: 41px; padding: 10px 12px; border: 1px solid #c5c2bd; font-size: 12px; text-align: center; }.candidate-modal__values input:checked + span { border-color: #171717; background: #171717; color: #fff; }.candidate-modal__values input:disabled + span { opacity: .35; text-decoration: line-through; cursor: not-allowed; }.candidate-modal__add { width: 100%; margin-top: 10px; padding: 17px; border: 1px solid #df483d; background: #df483d; color: #fff; font-size: 12px; font-weight: 700; letter-spacing: .1em; text-transform: uppercase; cursor: pointer; transition: background .2s ease, transform .2s ease; }.candidate-modal__add:hover:not(:disabled) { background: #bd3129; transform: translateY(-2px); }.candidate-modal__add:disabled { opacity: .5; cursor: not-allowed; }.candidate-modal__status { min-height: 20px; margin: 12px 0 0; font-size: 13px; }
  @media screen and (max-width: 749px) { .candidate-grid__cards { grid-template-columns: repeat(2, 1fr); gap: 20px 10px; }.candidate-grid__header { display: block; margin-bottom: 25px; }.candidate-grid__header p { margin-bottom: 10px; }.candidate-card__meta { display: block; line-height: 1.5; }.candidate-modal { width: calc(100vw - 20px); max-height: calc(100dvh - 20px); overflow: auto; }.candidate-modal__content { grid-template-columns: 1fr; }.candidate-modal__media { min-height: 290px; max-height: 42vh; }.candidate-modal__info { padding: 28px 22px; } }
  @media (prefers-reduced-motion: reduce) { .candidate-card__media img, .candidate-card__hotspot, .candidate-modal__add { transition: none; } }
{% endstylesheet %}

<script>
  (() => {
    const root = document.querySelector('.candidate-grid--{{ section.id }}');
    if (!root) return;
    const modal = root.querySelector('[data-product-modal]');
    const content = root.querySelector('[data-modal-content]');
    const money = (cents) => new Intl.NumberFormat(document.documentElement.lang || 'en', { style: 'currency', currency: '{{ cart.currency.iso_code | default: shop.currency }}' }).format(cents / 100);
    const escapeHtml = (value) => String(value).replace(/[&<>'"]/g, char => ({ '&':'&amp;', '<':'&lt;', '>':'&gt;', "'":'&#39;', '"':'&quot;' }[char]));

    const render = (product) => {
      const options = product.options_with_values || product.options.map((name, index) => ({ name, values: [...new Set(product.variants.map(variant => variant.options[index]))] }));
      content.innerHTML = `<div class="candidate-modal__media"><img src="${product.featured_image ? product.featured_image : ''}" alt="${escapeHtml(product.title)}"></div><div class="candidate-modal__info"><h3 class="candidate-modal__title">${escapeHtml(product.title)}</h3><p class="candidate-modal__price" data-price>${money(product.price)}</p><div class="candidate-modal__description">${product.description || ''}</div><form data-product-form>${options.map((option, optionIndex) => `<fieldset><legend>${escapeHtml(option.name)}</legend><div class="candidate-modal__values">${option.values.map((value, valueIndex) => `<label><input type="radio" name="option-${optionIndex}" value="${escapeHtml(value)}" ${valueIndex === 0 ? 'checked' : ''}><span>${escapeHtml(value)}</span></label>`).join('')}</div></fieldset>`).join('')}<button class="candidate-modal__add" type="submit">Add to cart</button><p class="candidate-modal__status" role="status" aria-live="polite"></p></form></div>`;
      const form = content.querySelector('[data-product-form]');
      const submit = form.querySelector('button');
      const updateVariant = () => {
        const values = options.map((_, index) => form.querySelector(`[name="option-${index}"]:checked`)?.value);
        const variant = product.variants.find(item => item.options.every((value, index) => value === values[index]));
        submit.disabled = !variant || !variant.available;
        submit.dataset.variantId = variant ? variant.id : '';
        submit.textContent = variant && variant.available ? 'Add to cart' : 'Sold out';
        if (variant) content.querySelector('[data-price]').textContent = money(variant.price);
      };
      form.addEventListener('change', updateVariant); updateVariant();
      form.addEventListener('submit', async event => {
        event.preventDefault(); const variant = product.variants.find(item => String(item.id) === submit.dataset.variantId); if (!variant) return;
        submit.disabled = true; const status = form.querySelector('[role="status"]'); status.textContent = 'Adding to cart…';
        const items = [{ id: variant.id, quantity: 1 }];
        const hasBlackMedium = variant.options.some(value => String(value).toLowerCase() === 'black') && variant.options.some(value => String(value).toLowerCase() === 'medium');
        const companionHandle = root.dataset.companionHandle;
        if (hasBlackMedium && companionHandle && product.handle !== companionHandle) {
          try { const companion = await fetch(`/products/${companionHandle}.js`).then(response => response.ok ? response.json() : null); const companionVariant = companion?.variants?.find(item => item.available); if (companionVariant) items.push({ id: companionVariant.id, quantity: 1 }); } catch (_) { /* Primary product can still be added if companion lookup fails. */ }
        }
        try { const response = await fetch('/cart/add.js', { method: 'POST', headers: { 'Content-Type': 'application/json', Accept: 'application/json' }, body: JSON.stringify({ items }) }); if (!response.ok) throw new Error(); status.textContent = items.length > 1 ? 'Both items were added to your cart.' : 'Added to your cart.'; document.dispatchEvent(new CustomEvent('cart:refresh')); } catch (_) { status.textContent = 'Unable to add this item. Please try again.'; submit.disabled = false; }
      });
    };
    root.querySelectorAll('[data-product-card]').forEach(button => button.addEventListener('click', () => { const json = button.closest('.candidate-card').querySelector('[data-product-json]'); if (!json) return; render(JSON.parse(json.textContent)); modal.showModal(); }));
    root.querySelector('[data-close-modal]').addEventListener('click', () => modal.close());
    modal.addEventListener('click', event => { if (event.target === modal) modal.close(); });
  })();
</script>

{% schema %}
{
  "name": "Candidate product grid",
  "max_blocks": 6,
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "The edit" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Meet the collection" },
    { "type": "product", "id": "companion_product", "label": "Soft Winter Jacket companion product", "info": "Automatically added when a selected variant has Black and Medium options." }
  ],
  "blocks": [{ "type": "product", "name": "Product", "settings": [{ "type": "product", "id": "product", "label": "Product" }] }],
  "presets": [{ "name": "Candidate product grid", "blocks": [{ "type": "product" }, { "type": "product" }, { "type": "product" }, { "type": "product" }, { "type": "product" }, { "type": "product" }] }]
}
{% endschema %}
