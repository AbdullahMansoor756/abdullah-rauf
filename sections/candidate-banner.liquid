{% comment %} Gift Guide banner — built from the supplied Figma assets. {% endcomment %}
<section class="candidate-banner">
  <div class="candidate-banner__announcement"><span class="candidate-banner__wordmark" aria-label="Tisso Vison"><img src="{{ 'candidate-logo-mark.svg' | asset_url }}" alt="" width="64" height="19"><img src="{{ 'candidate-logo-wordmark.svg' | asset_url }}" alt="" width="75" height="19"></span><span class="candidate-banner__message">{{ section.settings.announcement | escape }}</span>{% if section.settings.announcement_button_label != blank %}<a href="{{ section.settings.announcement_button_link | default: '#candidate-grid' }}"><span>{{ section.settings.announcement_button_label | escape }}</span><b aria-hidden="true">⟶</b></a>{% endif %}</div>
  <div class="candidate-banner__hero">
    <img class="candidate-banner__art" src="{{ 'candidate-hero-art.svg' | asset_url }}" alt="" width="1440" height="390">
    <img class="candidate-banner__detail" src="{{ 'candidate-hero-detail.svg' | asset_url }}" alt="" width="890" height="402">
    <div class="candidate-banner__copy"><h1>{{ section.settings.heading | escape }}</h1><div>{{ section.settings.text }}</div>{% if section.settings.button_label != blank %}<a class="candidate-banner__button" href="{{ section.settings.button_link | default: '#candidate-grid' }}">{{ section.settings.button_label | escape }} <span aria-hidden="true">⟶</span></a>{% endif %}</div>
  </div>
  <p class="candidate-banner__strapline">{{ section.settings.strapline | escape }}</p>
</section>
{% stylesheet %}
  .candidate-banner { color: #000; background: #fff; font-family: Jost, Arial, sans-serif; }
  .candidate-banner__announcement { display: grid; grid-template-columns: 151px 1fr 207px; align-items: center; height: 44px; padding: 0 50px; background: #f5f5f5; font-size: 16px; line-height: 1; }.candidate-banner__wordmark { position: relative; display: block; width: 151px; height: 19px; }.candidate-banner__wordmark img { position: absolute; top: 0; display: block; height: 19px; }.candidate-banner__wordmark img:first-child { left: 0; width: 64px; }.candidate-banner__wordmark img:last-child { right: 0; width: 75px; }.candidate-banner__message { text-align: center; font-size: 16px; }.candidate-banner__announcement a { display: flex; align-items: center; justify-content: space-between; box-sizing: border-box; width: 207px; height: 44px; padding: 0 22px 0 33px; background: #fff544; color: #000; font-size: 16px; text-decoration: none; text-transform: uppercase; }.candidate-banner__announcement b, .candidate-banner__button span { font-weight: 400; transition: transform .2s ease; }.candidate-banner__announcement a:hover b, .candidate-banner__button:hover span { transform: translateX(5px); }
  .candidate-banner__hero { position: relative; height: 780px; overflow: hidden; }.candidate-banner__art, .candidate-banner__detail { position: absolute; display: block; pointer-events: none; }.candidate-banner__art { top: 0; left: 0; width: 100%; height: 390px; }.candidate-banner__detail { right: 0; bottom: 0; width: 61.81%; height: auto; }.candidate-banner__copy { position: absolute; top: 425px; left: max(4.65%, 32px); width: min(483px, 42vw); }.candidate-banner__copy h1 { margin: 0; font-size: clamp(42px, 4.86vw, 70px); font-weight: 500; letter-spacing: -.04em; line-height: 1; }.candidate-banner__copy > div { margin-top: 45px; font-size: 20px; line-height: 1.4; }.candidate-banner__button { display: inline-flex; align-items: center; justify-content: space-between; box-sizing: border-box; width: 220px; height: 50px; margin-top: 43px; padding: 0 27px; background: #000; color: #fff; font-size: 16px; text-decoration: none; text-transform: uppercase; }.candidate-banner__strapline { margin: 0; padding: 10px 20px; background: #f5f5f5; font-size: 16px; line-height: 13px; text-align: center; text-transform: uppercase; }
  @media screen and (max-width: 749px) { .candidate-banner__announcement { display: flex; justify-content: center; height: 56px; padding: 0 16px; box-shadow: 0 2px 4px rgb(0 0 0 / 15%); }.candidate-banner__announcement::before { content: '☰'; position: absolute; left: 16px; font-size: 19px; }.candidate-banner__wordmark { transform: scale(1.12); transform-origin: center; }.candidate-banner__message, .candidate-banner__announcement a { display: none; }.candidate-banner__hero { height: 421px; }.candidate-banner__art { top: 145px; left: 50%; width: 686px; height: 186px; transform: translateX(-50%); }.candidate-banner__detail { display: none; }.candidate-banner__copy { top: 41px; left: 50%; width: 340px; transform: translateX(-50%); text-align: center; }.candidate-banner__copy h1 { font-size: 30px; }.candidate-banner__copy > div { margin-top: 18px; font-size: 16px; line-height: 1.3; }.candidate-banner__copy > div p:not(:first-child) { display: none; }.candidate-banner__button { width: auto; height: auto; margin-top: 156px; padding: 14px 20px; font-size: 16px; }.candidate-banner__strapline { padding: 10px 8px; font-size: 14px; white-space: nowrap; } }
{% endstylesheet %}
{% schema %}
{ "name": "Candidate banner", "settings": [{ "type": "text", "id": "announcement", "label": "Announcement text", "default": "Find the ideal gift for your loved ones." }, { "type": "text", "id": "announcement_button_label", "label": "Announcement button label", "default": "Choose gift" }, { "type": "url", "id": "announcement_button_link", "label": "Announcement button link" }, { "type": "text", "id": "heading", "label": "Heading", "default": "The Gift Guide" }, { "type": "richtext", "id": "text", "label": "Description", "default": "<p>Discover Joy: Your Ultimate Holiday Gift Destination. Explore our curated selection and find the perfect gifts to delight your loved ones this holiday season.</p>" }, { "type": "text", "id": "button_label", "label": "Button label", "default": "Shop now" }, { "type": "url", "id": "button_link", "label": "Button link" }, { "type": "text", "id": "strapline", "label": "Bottom strapline", "default": "Sustainable, ethically made clothes in sizes XXS to 6XL" }], "presets": [{ "name": "Candidate banner" }] }
{% endschema %}
